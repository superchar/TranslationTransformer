<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\TranslatorTransformer.Core\TranslatorTransformer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Translations\EN.txt" />
      <Content Include="Translations\EN.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Translations\RU.txt" />
      <Content Include="Translations\RU.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="TransformerWeightsCache.dat" />
      <None Remove="BPETokenizerCache.json" />
      <Content Update="Cache\BPETokenizerCache.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Update="Cache\TransformerWeightsCache.dat">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Update="Cache\BPETokenizerCache.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Remove="Cache\TransformerWeightsCache.dat" />
      <Content Include="Cache\TransformerWeightsCache.dat">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    

</Project>
